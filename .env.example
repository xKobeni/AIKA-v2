# Local AIKA settings. Restart AIKA after editing this file.
# Paste your Tavily key after the equals sign; never commit this file.
AIKA_TAVILY_API_KEY=

# Set on to allow network searches. Set provider to tavily to use your key.
AIKA_WEB_SEARCH_ENABLED=off
AIKA_WEB_SEARCH_PROVIDER=auto
# Tavily may consume credits. Fallback requires a separate explicit opt-in.
AIKA_WEB_SEARCH_FALLBACK_ENABLED=off
AIKA_WEB_SEARCH_FALLBACK_PROVIDER=tavily

# Explicit opt-in for reading selected HTTPS search results.
AIKA_WEB_READING_ENABLED=off

# Opt-in fixed-label diagnostics; no queries, pages, responses or secrets.
AIKA_WEB_DEBUG=off

# Automatic research respects both existing web gates and provider billing policy.
AIKA_RESEARCH_TIMEOUT=180
# local uses the OS timezone; an IANA name such as Asia/Manila is also supported.
AIKA_TIMEZONE=local

# Controlled agent: 4 plan steps, 8 executor calls, 2 model generations (fixed caps).
# Includes any nested research; cooperative deadline, not hard preemption.
AIKA_AGENT_TIMEOUT=180

# Model input content budget (characters, not an exact tokenizer count).
# Retain 0-50 completed turns; older complete pairs are omitted from model input as needed.
AIKA_CONTEXT_TURNS=10
# Supported input range: 4096-64000. Never truncates the newest message or system instruction.
AIKA_CONTEXT_CHARS=24000
# Ordinary chat output cap: 64-4096 tokens. Structured workflows keep their existing caps.
AIKA_RESPONSE_TOKENS=1024
