# Local AIKA settings. Restart AIKA after editing this file.
# Paste your Tavily key after the equals sign; never commit this file.
AIKA_TAVILY_API_KEY=

# Set on to allow network searches. Set provider to tavily to use your key.
AIKA_WEB_SEARCH_ENABLED=off
AIKA_WEB_SEARCH_PROVIDER=auto
# Tavily may consume credits. Fallback requires a separate explicit opt-in.
AIKA_WEB_SEARCH_FALLBACK_ENABLED=off
AIKA_WEB_SEARCH_FALLBACK_PROVIDER=tavily

# Explicit opt-in for reading selected HTTPS search results.
AIKA_WEB_READING_ENABLED=off
